  warn: { fg: "text-warn", wash: "bg-warn-wash", rule: "border-warn" },
  crit: { fg: "text-crit", wash: "bg-crit-wash", rule: "border-crit" },
  idle: { fg: "text-idle", wash: "bg-idle-wash", rule: "border-idle" },
