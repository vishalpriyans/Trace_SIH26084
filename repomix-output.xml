  user,
  userMeta,
  searchPlaceholder = "Search the queue by phrase, reporter or activity",
  preferred = "dark",
  notifications,
}: {
  crumbs: string[];
  user: string;
  userMeta: string;
  searchPlaceholder?: string;
  preferred?: "dark" | "light";
  notifications?: number;
}) {
