                    <td className="px-4 py-3 align-top">
                      <div className="flex items-center gap-2">
                        <span className="block h-1.5 w-16 overflow-hidden rounded-full bg-sunken">
                          <span
                            className="block h-full rounded-full bg-ramp-3"
