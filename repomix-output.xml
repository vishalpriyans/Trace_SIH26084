    ok: true,
    apiVersion: MOBILE_API_VERSION,
    serverTime: new Date().toISOString(),
    provenance: {
      dataSource: DATA_SOURCE,
      matcherBuilt: MATCHER_BUILT,
      writesPersist: WRITES_PERSIST,
    },
  });
}

