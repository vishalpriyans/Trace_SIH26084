              className="flex h-11 flex-1 items-center justify-center gap-2 rounded-[var(--radius-control)] bg-accent text-[length:var(--text-body)] font-medium text-accent-ink"
            >
              <ArrowClockwise size={16} aria-hidden />
              Try again
