# ---- Supabase -------------------------------------------------------
# Project URL: Supabase dashboard -> Project Settings -> Data API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# The SECRET key. In current Supabase this is labelled SUPABASE_SECRET_KEY and
# its value starts with  sb_secret_...  (Project Settings -> API Keys -> the one
# with the reveal/eye icon). It was previously called the "service_role" key.
# NOT the sb_publishable_... key -- that one respects RLS and cannot write here.
# This bypasses RLS. Server-side only. Never commit it, never paste it in chat.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Secrets you invent yourself ------------------------------------
# Generate each with:  openssl rand -hex 24
# Bearer token Sarvam sends to /voice/log_update
TOOL_BEARER_TOKEN=
# Goes in the webhook URL path, because webhook_config has no header field
WEBHOOK_PATH_SECRET=

# ---- Sarvam (needed only to place an outbound call) -----------------
# Dashboard -> API Keys. Sent as the X-API-Key header.
SARVAM_API_KEY=
# Fixed for this project, confirmed from the dashboard URL.
SARVAM_ORG_ID=01a03cdf-0617-7940-9abd-40d8529c47d9
SARVAM_WORKSPACE_ID=01a03cdf-061c-79fa-a613-9520c2afefe2
# The voice agent's app id, and the published version number (usually 1).
SARVAM_APP_ID=
SARVAM_APP_VERSION=1
# Telephony connection id, and the number the agent dials OUT from.
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE_NUMBER=
