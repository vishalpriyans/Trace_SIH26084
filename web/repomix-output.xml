              count: counts.queueDepth,
              tone: "accent",
            },
            {
              href: "/console/coverage",
              screen: "W2",
              label: "Coverage",
              icon: UsersThree,
              count: counts.notReported,
              tone: "warn",
            },
            {
              href: "/console/blockers",
              screen: "W5",
              label: "Blockers",
              icon: Warning,
              count: counts.agedBlockers,
              tone: "crit",
