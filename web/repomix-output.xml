                          {a.percentComplete}%
                        </span>
                      </div>
                      {a.quantityUnit && (
                        <div className="mt-1 font-mono text-[length:var(--text-label)] text-ink-meta tnum">
                          {a.quantityDone} of {a.quantityPlanned} {a.quantityUnit}
                        </div>
                      )}
